              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_NoneType_"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Me",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
