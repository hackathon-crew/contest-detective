              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_Union_PublicUser__NoneType__"
                }
              }
            }
          }
        }
      }
    },
    "/user/profile": {
      "put": {
        "summary": "Confirm Profile",
        "operationId": "confirm_profile_user_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_PublicUser_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/profile/github": {
      "post": {
        "summary": "Github Profile",
        "operationId": "github_profile_profile_github_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_Profile_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/profile/resume": {
      "post": {
        "summary": "Resume Profile",
        "operationId": "resume_profile_profile_resume_post",
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "resume.pdf",
                "resume.docx",
                "resume.txt"
              ],
              "type": "string",
              "title": "Filename"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_Profile_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/match": {
      "post": {
        "summary": "Match Profile",
        "operationId": "match_profile_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_list_MatchItem__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/contests": {
      "get": {
        "summary": "List Contests",
        "operationId": "list_contests_contests_get",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Keyword"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "upcoming",
                    "ongoing",
                    "ended"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "online",
                    "offline",
                    "hybrid"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mode"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date From"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date To"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ids"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "deadline",
                "start"
              ],
              "type": "string",
              "default": "deadline",
              "title": "Sort"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_ContestSummary_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/contests/{contest_id}": {
      "get": {
        "summary": "Contest Detail",
        "operationId": "contest_detail_contests__contest_id__get",
        "parameters": [
          {
            "name": "contest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Contest Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response_ContestDetail_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agent/ask": {
      "post": {
        "summary": "Ask Question",
        "operationId": "ask_question_agent_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            },
            "type": "array",
            "maxItems": 12,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "Availability": {
        "properties": {
          "weekdays": {
            "items": {
              "type": "integer",
              "maximum": 6.0,
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 7,
            "title": "Weekdays"
          },
          "windows": {
            "items": {
              "$ref": "#/components/schemas/AvailabilityWindow"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Windows"
          },
          "max_consecutive_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 30.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Consecutive Days"
          }
        },
        "type": "object",
        "title": "Availability"
      },
      "AvailabilityWindow": {
        "properties": {
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          }
        },
        "type": "object",
        "required": [
          "start_at",
          "end_at"
        ],
        "title": "AvailabilityWindow"
      },
      "ContestDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "cover_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Url"
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "ongoing",
              "ended"
            ],
            "title": "Status"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldValue"
            },
            "propertyNames": {
              "enum": [
                "start_at",
                "end_at",
                "registration_deadline",
                "submission_deadline",
                "deadline_unspecified",
                "city",
                "mode",
                "prize",
                "registration_url",
                "organizer",
                "venue",
                "eligibility",
                "team_size",
                "entry_fee",
                "entry_requirements",
                "judging_criteria",
                "past_statistics"
              ]
            },
            "type": "object",
            "title": "Fields"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "cover_url",
          "status",
          "fields",
          "summary"
        ],
        "title": "ContestDetail"
      },
      "ContestSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "cover_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Url"
          },
          "status": {
            "type": "string",
            "enum": [
              "upcoming",
              "ongoing",
              "ended"
            ],
            "title": "Status"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldValue"
            },
            "propertyNames": {
              "enum": [
                "start_at",
                "end_at",
                "registration_deadline",
                "submission_deadline",
                "deadline_unspecified",
                "city",
                "mode",
                "prize",
                "registration_url",
                "organizer",
                "venue",
                "eligibility",
                "team_size",
                "entry_fee",
                "entry_requirements",
                "judging_criteria",
                "past_statistics"
              ]
            },
            "type": "object",
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "cover_url",
          "status",
          "fields"
        ],
        "title": "ContestSummary"
      },
      "ConversationMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationMessage"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "FieldValue": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "level": {
            "type": "string",
            "enum": [
              "official",
              "reposted",
              "conflict",
              "not_found"
            ],
            "title": "Level"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "precision": {
            "type": "string",
            "enum": [
              "day",
              "datetime"
            ],
            "title": "Precision",
            "default": "datetime"
          }
        },
        "type": "object",
        "required": [
          "value",
          "level"
        ],
        "title": "FieldValue"
      },
      "GitHubEvidence": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "maxLength": 300,
            "title": "Url"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "topics": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 50,
            "title": "Topics"
          },
          "pushed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pushed At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "title": "GitHubEvidence"
      },
      "GitHubInput": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "GitHubInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListResponse_ContestSummary_": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "description": "业务状态码：成功 200，失败非 200",
            "default": 200
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "提示信息",
            "default": "success"
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ContestSummary"
            },
            "type": "array",
            "title": "Data",
            "description": "业务数据列表"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "数据总数",
            "default": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "当前页码，从 1 开始",
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page Size",
            "description": "每页条数；0 表示不分页",
            "default": 0
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp",
            "description": "响应时间；默认不携带，不携带时省略"
          }
        },
        "type": "object",
        "title": "ListResponse[ContestSummary]"
      },
      "MatchItem": {
        "properties": {
          "contest": {
            "$ref": "#/components/schemas/ContestSummary"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "contest",
          "reason",
          "score"
        ],
        "title": "MatchItem"
      },
      "Profile": {
        "properties": {
          "skills": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 50,
            "title": "Skills"
          },
          "identity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Identity"
          },
          "available_time": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Time"
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "github": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github"
          },
          "topics": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 50,
            "title": "Topics"
          },
          "preferred_modes": {
            "items": {
              "type": "string",
              "enum": [
                "online",
                "offline",
                "hybrid"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "title": "Preferred Modes"
