{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "lib": ["ES2022", "DOM"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/bundle/lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
