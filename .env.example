# 进程级配置，前缀 DETECTIVE_
DETECTIVE_LOG_LEVEL=INFO

# 本地默认不自动同步；部署时设为 360，并保持单个服务进程
DETECTIVE_SYNC_INTERVAL_MINUTES=0
# false 只暂停周期和 CLI 的模型抽取，结构化来源仍同步
DETECTIVE_SYNC_EXTRACT_ENABLED=true

# SQLite 文件地址，前缀 DETECTIVE_DB_，只接受 sqlite URL
DETECTIVE_DB_URL=sqlite:///./contest_detective.db

# 元宝搜索使用腾讯云 SecretId 和 SecretKey；两者都配置才启用
DETECTIVE_YUANBAO_SECRET_ID=
DETECTIVE_YUANBAO_SECRET_KEY=

# 模型默认关闭；启用前配置供应商和密钥，不把真实值提交到仓库
DETECTIVE_LLM_ENABLED=false
DETECTIVE_LLM_API_KEY=
DETECTIVE_LLM_BASE_URL=https://api.deepseek.com
DETECTIVE_LLM_MODEL=deepseek-flash

# local 执行本地额度和余额保护；external 由供应商执行额度，不查询余额，仍逐次记账
DETECTIVE_LLM_LIMITS_MODE=local
DETECTIVE_LLM_BUDGET_CNY=1.5
DETECTIVE_LLM_BALANCE_FLOOR_CNY=90
DETECTIVE_LLM_MAX_TOKENS=4096
DETECTIVE_LLM_MAX_INPUT_TOKENS=65536

# DeepSeek 专属 thinking 选项；其他兼容供应商设 false，只发送通用请求字段
DETECTIVE_LLM_DEEPSEEK_OPTIONS=true

# 可选 GitHub 公共资料读取额度；不使用用户 OAuth
DETECTIVE_GITHUB_TOKEN=
# 可选替代搜索；同时配置元宝时仍优先混合元宝结果
DETECTIVE_TAVILY_API_KEY=
