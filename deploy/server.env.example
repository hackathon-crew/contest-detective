DETECTIVE_DB_URL=sqlite:////var/lib/contest-detective/contest.db
DETECTIVE_SYNC_INTERVAL_MINUTES=0
DETECTIVE_SYNC_DAILY_AT=03:00
DETECTIVE_SYNC_WINDOW_MINUTES=60
DETECTIVE_SYNC_COLLECT=both
DETECTIVE_LLM_ENABLED=false
DETECTIVE_LLM_BASE_URL=https://api.deepseek.com
DETECTIVE_LLM_MODEL=deepseek-flash
DETECTIVE_LLM_API_KEY=
DETECTIVE_LLM_BUDGET_CNY=3.5
DETECTIVE_LLM_BALANCE_FLOOR_CNY=90
DETECTIVE_LLM_MAX_TOKENS=8192
# 仅 local 模式用于本地金额预留；external 模式的上下文由网关和模型管理
DETECTIVE_LLM_MAX_INPUT_TOKENS=65536
# 结构化来源归一化提示词；相对路径由 backend/src/contest_detective/agent 目录解析
DETECTIVE_LLM_NORMALIZATION_PROMPT_PATH=templates/contest_normalization.jinja2
DETECTIVE_YUANBAO_SECRET_ID=
DETECTIVE_YUANBAO_SECRET_KEY=
DETECTIVE_GITHUB_TOKEN=

# 个人中心：生产环境使用独立的 Fernet 主密钥，生成方式见根目录 .env.example
DETECTIVE_ACCOUNT_ENCRYPTION_KEY=
DETECTIVE_PUBLIC_BASE_URL=https://inkpaw.windup.xin
DETECTIVE_QUERY_LIMITS_ENABLED=false
# Resend 默认不发信；启用前配置已验证的发信地址，付费前确认预算
DETECTIVE_MAIL_ENABLED=false
DETECTIVE_RESEND_API_KEY=
DETECTIVE_RESEND_WEBHOOK_SECRET=
DETECTIVE_MAIL_SENDER=
DETECTIVE_MAIL_DAILY_LIMIT=100
DETECTIVE_MAIL_MONTHLY_LIMIT=3000
