[Unit]
Description=Inkpaw MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contest-detective
Group=contest-detective
WorkingDirectory=/srv/contest-detective/backend
EnvironmentFile=/etc/contest-detective.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/contest-detective/backend/.venv/bin/uvicorn contest_detective.bootstrap.mcp_http:create_app --factory --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/contest-detective

[Install]
WantedBy=multi-user.target
